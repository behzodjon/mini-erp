# Copy to .env (never commit .env). Generate a hash with: pnpm hash-password <password>
PORT=3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=beverage_shop
OWNER_USERNAME=owner
# bcrypt hash of the owner password. This example hash is for the password "change-me".
OWNER_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
