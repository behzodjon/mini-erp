{
  "name": "beverage-shop-mini-erp",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "dev": "pnpm --parallel --filter @erp/api --filter @erp/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "hash-password": "pnpm --filter @erp/api hash-password",
    "seed": "pnpm --filter @erp/api seed",
    "seed:prod": "pnpm --filter @erp/api seed:prod",
    "build": "pnpm --filter @erp/web build",
    "start": "pnpm --filter @erp/api start:prod"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3"
}
