{
  "name": "@erp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "seed": "tsx --env-file=../../.env scripts/seed.ts",
    "seed:prod": "tsx --env-file=../../.env.production scripts/seed.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "start:prod": "tsx src/main.ts"
  },
  "dependencies": {
    "@erp/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.8",
    "bcryptjs": "^3.0.0",
    "fastify": "^5.2.0",
    "mongodb": "^6.12.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "mongodb-memory-server": "^10.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
